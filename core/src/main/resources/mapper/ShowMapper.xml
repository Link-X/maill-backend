<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ticket.core.mapper.ShowMapper">

    <!-- ============== 列清单（修改 show 表字段时只改这里） ============== -->
    <!-- 不带前缀，用于 INSERT 列名 / 单表 SELECT -->
    <sql id="Columns">
        id, name, description, category_id, city_code, address,
        poster_url, venue, status, review_mode, avg_rating, review_count, open_sale_time,
        extend, create_time, update_time
    </sql>
    <!-- 带 s. 前缀，用于 JOIN 查询 -->
    <sql id="ColumnsAliased">
        s.id, s.name, s.description, s.category_id, s.city_code, s.address,
        s.poster_url, s.venue, s.status, s.review_mode, s.avg_rating, s.review_count, s.open_sale_time,
        s.extend, s.create_time, s.update_time
    </sql>

    <!-- 演出实体映射（管理端写入与基础查询使用） -->
    <resultMap id="ShowResultMap" type="com.ticket.core.domain.entity.Show">
        <id     column="id"          property="id"/>
        <result column="name"        property="name"/>
        <result column="description" property="description"/>
        <result column="category_id" property="categoryId"/>
        <result column="city_code"   property="cityCode"/>
        <result column="address"     property="address"/>
        <result column="poster_url"  property="posterUrl"/>
        <result column="venue"       property="venue"/>
        <result column="status"      property="status"/>
        <result column="review_mode"   property="reviewMode"/>
        <result column="avg_rating"    property="avgRating"/>
        <result column="review_count"  property="reviewCount"/>
        <result column="open_sale_time" property="openSaleTime"/>
        <result column="extend"      property="extend" typeHandler="com.ticket.core.mybatis.JsonMapTypeHandler"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <!-- ShowVO 映射：实体 + LEFT JOIN category / city 的冗余名称 -->
    <resultMap id="ShowVOResultMap" type="com.ticket.core.domain.vo.ShowVO">
        <id     column="id"            property="id"/>
        <result column="name"          property="name"/>
        <result column="description"   property="description"/>
        <result column="category_id"   property="categoryId"/>
        <result column="category_name" property="categoryName"/>
        <result column="city_code"     property="cityCode"/>
        <result column="city_name"     property="cityName"/>
        <result column="address"       property="address"/>
        <result column="poster_url"    property="posterUrl"/>
        <result column="venue"         property="venue"/>
        <result column="status"        property="status"/>
        <result column="review_mode"    property="reviewMode"/>
        <result column="avg_rating"     property="avgRating"/>
        <result column="review_count"   property="reviewCount"/>
        <result column="open_sale_time" property="openSaleTime"/>
        <result column="extend"        property="extend" typeHandler="com.ticket.core.mybatis.JsonMapTypeHandler"/>
        <result column="create_time"   property="createTime"/>
        <result column="update_time"   property="updateTime"/>
    </resultMap>

    <insert id="insert" parameterType="com.ticket.core.domain.entity.Show" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO `show` (name, description, category_id, city_code, address,
                            poster_url, venue, status, review_mode, avg_rating, review_count, open_sale_time,
                            extend, create_time, update_time)
        VALUES (#{name}, #{description}, #{categoryId}, #{cityCode}, #{address},
                #{posterUrl}, #{venue}, #{status}, #{reviewMode}, #{avgRating}, #{reviewCount}, #{openSaleTime},
                #{extend,typeHandler=com.ticket.core.mybatis.JsonMapTypeHandler}, #{createTime}, #{updateTime})
    </insert>

    <update id="update" parameterType="com.ticket.core.domain.entity.Show">
        UPDATE `show`
        SET name        = #{name},
            description = #{description},
            category_id = #{categoryId},
            city_code   = #{cityCode},
            address     = #{address},
            poster_url  = #{posterUrl},
            venue       = #{venue},
            status      = #{status},
            review_mode    = #{reviewMode},
            open_sale_time = #{openSaleTime},
            extend      = #{extend,typeHandler=com.ticket.core.mybatis.JsonMapTypeHandler},
            update_time = #{updateTime}
        WHERE id = #{id}
    </update>

    <select id="selectById" resultMap="ShowResultMap">
        SELECT <include refid="Columns"/>
        FROM `show`
        WHERE id = #{id}
    </select>

    <!--
      admin 后台下拉/筛选用，加 LIMIT 兜底防止表增长后一次性加载到 JVM 堆。
      如确需取全部，应改用 selectByStatus + 分页接口。
    -->
    <select id="selectAll" resultMap="ShowResultMap">
        SELECT <include refid="Columns"/>
        FROM `show`
        ORDER BY create_time DESC
        LIMIT 1000
    </select>

    <select id="selectByStatus" resultMap="ShowResultMap">
        SELECT <include refid="Columns"/>
        FROM `show`
        WHERE status = #{status}
        ORDER BY create_time DESC
    </select>

    <!--
      VO 查询：LEFT JOIN category & city 取 categoryName / cityName。
      LEFT JOIN 保证 category_id / city_code 为空的旧数据仍能查出来。
      name/venue 走 idx_name / idx_venue 前缀索引；categoryId 走 idx_category_id；cityCode 走 idx_city_code。
    -->
    <select id="selectVOByCondition" resultMap="ShowVOResultMap">
        SELECT <include refid="ColumnsAliased"/>,
               c.name AS category_name, ct.name AS city_name
        FROM `show` s
        LEFT JOIN category c  ON c.id   = s.category_id
        LEFT JOIN city     ct ON ct.code = s.city_code
        <where>
            <if test="status != null">AND s.status = #{status}</if>
            <if test="name != null and name != ''">AND s.name LIKE CONCAT(#{name}, '%')</if>
            <if test="categoryId != null">AND s.category_id = #{categoryId}</if>
            <if test="cityCode != null and cityCode != ''">AND s.city_code = #{cityCode}</if>
            <if test="venue != null and venue != ''">AND s.venue LIKE CONCAT(#{venue}, '%')</if>
        </where>
        ORDER BY s.create_time DESC
        LIMIT #{size} OFFSET #{offset}
    </select>

    <select id="countByCondition" resultType="int">
        SELECT COUNT(*)
        FROM `show` s
        <where>
            <if test="status != null">AND s.status = #{status}</if>
            <if test="name != null and name != ''">AND s.name LIKE CONCAT(#{name}, '%')</if>
            <if test="categoryId != null">AND s.category_id = #{categoryId}</if>
            <if test="cityCode != null and cityCode != ''">AND s.city_code = #{cityCode}</if>
            <if test="venue != null and venue != ''">AND s.venue LIKE CONCAT(#{venue}, '%')</if>
        </where>
    </select>

    <select id="selectVOById" resultMap="ShowVOResultMap">
        SELECT <include refid="ColumnsAliased"/>,
               c.name AS category_name, ct.name AS city_name
        FROM `show` s
        LEFT JOIN category c  ON c.id   = s.category_id
        LEFT JOIN city     ct ON ct.code = s.city_code
        WHERE s.id = #{id}
    </select>

    <select id="selectByIds" resultMap="ShowResultMap">
        SELECT <include refid="Columns"/>
        FROM `show`
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

</mapper>
