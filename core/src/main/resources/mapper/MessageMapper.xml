<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ticket.core.mapper.MessageMapper">

    <resultMap id="MessageResultMap" type="com.ticket.core.domain.entity.Message">
        <id     column="id"          property="id"/>
        <result column="type"        property="type"/>
        <result column="title"       property="title"/>
        <result column="content"     property="content"/>
        <result column="link_type"   property="linkType"/>
        <result column="link_target" property="linkTarget"/>
        <result column="broadcast"   property="broadcast"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <sql id="AllColumns">
        id, type, title, content, link_type, link_target, broadcast, create_time, update_time
    </sql>

    <insert id="insert" parameterType="com.ticket.core.domain.entity.Message" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO message (type, title, content, link_type, link_target, broadcast, create_time, update_time)
        VALUES (#{type}, #{title}, #{content}, #{linkType}, #{linkTarget}, #{broadcast}, #{createTime}, #{updateTime})
    </insert>

    <select id="selectById" resultMap="MessageResultMap">
        SELECT <include refid="AllColumns"/> FROM message WHERE id = #{id}
    </select>

    <select id="selectBroadcasts" resultMap="MessageResultMap">
        SELECT <include refid="AllColumns"/> FROM message WHERE broadcast = 1
    </select>

    <select id="selectByCondition" resultMap="MessageResultMap">
        SELECT <include refid="AllColumns"/> FROM message
        <where>
            <if test="type != null">AND type = #{type}</if>
            <if test="broadcast != null">AND broadcast = #{broadcast}</if>
        </where>
        ORDER BY id DESC
        <if test="offset != null and size != null">LIMIT #{size} OFFSET #{offset}</if>
    </select>

    <select id="countByCondition" resultType="int">
        SELECT COUNT(*) FROM message
        <where>
            <if test="type != null">AND type = #{type}</if>
            <if test="broadcast != null">AND broadcast = #{broadcast}</if>
        </where>
    </select>
</mapper>
