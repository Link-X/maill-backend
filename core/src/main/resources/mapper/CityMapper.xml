<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ticket.core.mapper.CityMapper">

    <resultMap id="CityResultMap" type="com.ticket.core.domain.entity.City">
        <id     column="id"          property="id"/>
        <result column="code"        property="code"/>
        <result column="name"        property="name"/>
        <result column="sort"        property="sort"/>
        <result column="status"      property="status"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <select id="selectEnabled" resultMap="CityResultMap">
        SELECT id, code, name, sort, status, create_time, update_time
        FROM city
        WHERE status = 1
        ORDER BY sort ASC, id ASC
    </select>

    <select id="selectByCondition" resultMap="CityResultMap">
        SELECT id, code, name, sort, status, create_time, update_time
        FROM city
        <where>
            <if test="status != null">AND status = #{status}</if>
            <if test="keyword != null and keyword != ''">
                AND name LIKE CONCAT(#{keyword}, '%')
            </if>
        </where>
        ORDER BY sort ASC, id ASC
    </select>

    <select id="selectByCode" resultMap="CityResultMap">
        SELECT id, code, name, sort, status, create_time, update_time
        FROM city WHERE code = #{code}
    </select>

    <select id="selectByCodes" resultMap="CityResultMap">
        SELECT id, code, name, sort, status, create_time, update_time
        FROM city
        WHERE code IN
        <foreach collection="codes" item="code" open="(" separator="," close=")">
            #{code}
        </foreach>
    </select>

</mapper>
